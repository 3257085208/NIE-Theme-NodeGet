# NodeGet 标准主题配置。复制为 .env.local 后本地开发/构建会自动生成 public/config.json 与 dist/config.json。
# Cloudflare Pages / 其他静态托管平台也可以直接设置 NODEGET_CONFIG 环境变量。
NODEGET_CONFIG='{
  "user_preferences": {
    "site_name": "NodeGet Status",
    "site_logo": "",
    "footer": "Powered by NodeGet",
    "refresh_interval_ms": 10000
  },
  "site_tokens": [
    {
      "name": "master server node 1",
      "backend_url": "wss://your-backend.example.com",
      "token": "YOUR_VISITOR_TOKEN_HERE"
    }
  ]
}'

# 兼容旧部署方式：没有 NODEGET_CONFIG 时，也可以继续使用 SITE_n。
# SITE_NAME=NodeGet Status
# SITE_LOGO=
# SITE_FOOTER=Powered by NodeGet
# REFRESH_INTERVAL_MS=10000
# SITE_1=name="master-1",backend_url="wss://your-backend.example.com",token="YOUR_VISITOR_TOKEN_HERE"

# 首页卡片指标样式：circle=圆环，bar=18格横条
HOME_CARD_METRIC_STYLE=circle

# 首页延迟指定线路，多个用逗号分隔；留空显示全部
# HOME_TCPING_INCLUDE=上海电信,福建电信,上海移动
# HOME_TCPING_INCLUDE=sh-ct,fj-ct,sh-cm

# 首页延迟显示开关，默认只显示 IPv4 TCP Ping
HOME_SHOW_IPV4_PING=false
HOME_SHOW_IPV4_TCPING=true
HOME_SHOW_IPV6_PING=false
HOME_SHOW_IPV6_TCPING=false

# VPS 详情页延迟显示开关
DETAIL_SHOW_IPV4_PING=true
DETAIL_SHOW_IPV4_TCPING=true
DETAIL_SHOW_IPV6_PING=true
DETAIL_SHOW_IPV6_TCPING=true


# 外观设置（Fork GitHub + Cloudflare / Vercel 部署时可用）
# 可选：cloud, mint, blue, purple, peach, rose, yellow, slate, sea, forest
BACKGROUND_PALETTE=cloud
# 可选：grid, solid, dots
BACKGROUND_PATTERN=grid
# 背景纹理密度，建议 12-48
BACKGROUND_DENSITY=22
# 背景纹理强度百分比，建议 2-24
BACKGROUND_OPACITY=10
